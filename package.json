  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --clear",
    "start:test": "dotenv -e .env.test -- expo start --clear --port 8082",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "sitemap": "node scripts/sitemap-olustur.mjs",
    "seo:audit": "node scripts/seo-audit.mjs && node scripts/public-seo-test.mjs",
    "seo:public": "node scripts/public-seo-test.mjs",
    "export:web": "node scripts/sitemap-olustur.mjs && expo export --platform web && node scripts/web-site-olustur.mjs && node scripts/blog-olustur.mjs",
    "blog:test": "node scripts/blog-test.mjs",
    "blog:html": "node scripts/blog-olustur.mjs",
    "typecheck": "tsc --noEmit",
    "load:100": "npm --prefix load-tests run load:100",
    "load:500": "npm --prefix load-tests run load:500",
    "load:1000": "npm --prefix load-tests run load:1000",
    "load:2500": "npm --prefix load-tests run load:2500",
    "load:5000": "npm --prefix load-tests run load:5000",
    "load:7500": "npm --prefix load-tests run load:7500",
    "load:10000": "npm --prefix load-tests run load:10000",
    "load:ladder": "npm --prefix load-tests run load:ladder",
    "load:run": "npm --prefix load-tests run load:run --",
    "load:realtime": "npm --prefix load-tests run load:realtime",
    "test:fruit-wheel-secim": "npx --yes tsx scripts/fruit-wheel-secim.test.ts",
    "test:takip": "npx --yes tsx scripts/takip-tests.ts",
    "test:cevrimdisi": "npx --yes tsx scripts/cevrimdisi-tests.ts",
    "test:ekonomi-sql": "npx --yes tsx scripts/ekonomi-sql-tests.ts",
    "test:oyun-cuzdan": "npx --yes tsx scripts/oyun-cuzdan-sql-tests.ts",
    "test:yayinci-banka": "npx --yes tsx scripts/yayinci-banka-rehberi-sql-tests.ts",
    "test:yayinci-profil": "npx --yes tsx scripts/yayinci-odeme-profili-sql-tests.ts",
    "test:tamuso-verify": "npx --yes tsx scripts/tamuso-verify-sql-tests.ts",
    "test:tamuso-verify-istemci": "npx --yes tsx scripts/tamuso-verify-istemci-tests.ts",
    "eas-build-pre-install": "npm config set legacy-peer-deps true",
    "eas:whoami": "eas whoami",
    "eas:dev": "eas build --profile development --platform android",
    "eas:dev:ios": "eas build --profile development --platform ios",
    "eas:dev:ios:simulator": "eas build --profile development-simulator --platform ios",
    "eas:preview": "eas build --profile preview --platform android",
    "eas:prod": "eas build --profile production --platform all",
    "supabase:login": "node scripts/supabase-login.js",
    "supabase:deploy": "dotenv -e .env.supabase.local -- npx supabase functions deploy --project-ref vdkqrqtrftzhbtquzked --use-api",
    "supabase:db:push": "dotenv -e .env.supabase.local -- npx supabase db push --linked",
    "supabase:link": "dotenv -e .env.supabase.local -- npx supabase link --project-ref vdkqrqtrftzhbtquzked",
    "sb": "dotenv -e .env.supabase.local -- npx supabase",
    "db:push": "npm run supabase:db:push",
    "functions:deploy": "npm run supabase:deploy",
    "supabase:help": "node -e \"console.log('Kullan:\\n  npm run supabase:login\\n  npm run db:push\\n  npm run functions:deploy\\n\\nASLA: npx supabase db push / supabase functions deploy (401 verir)')\""
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@supersami/rn-foreground-service",
          "expo-pip"
        ],
        "listUnknownPackages": false
      }
    }
  }
